/* TRACER-CV Dark Theme */
QWidget { background: #111a22; color: #e3ebf1; font-family: "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10pt; }
QMainWindow { background: #111a22; }
QDialog { background: #111a22; }

/* ── Sidebar ─────────────────────────────────────────── */
QFrame#sidebar { background: #0b131a; color: #e3ebf1; border: none; }
QFrame#sidebar QLabel { color: #e3ebf1; }
QLabel#brand { color: #ffffff; font-size: 13pt; font-weight: 700; padding: 4px 2px 10px 2px; }
QLabel#sidebarFooter { color: #4e6a7a; font-size: 8pt; padding: 8px 2px; }
QLabel#groupHeader { color: #3e6070; font-size: 7pt; font-weight: 700; letter-spacing: 1.5px; padding: 14px 4px 3px 4px; }

/* Navigation tree */
QTreeWidget#navigation { background: transparent; color: #c8d4dd; border: none; outline: none; }
QTreeWidget#navigation::item { padding: 7px 8px; border-radius: 4px; min-height: 28px; }
QTreeWidget#navigation::item:hover { background: #1a2e3d; }
QTreeWidget#navigation::item:selected { background: #1e4976; color: #ffffff; font-weight: 700; }

/* ── App header ──────────────────────────────────────── */
QFrame#appHeader { background: #19242e; border: none; border-bottom: 1px solid #344552; }
QLabel#pageContext { color: #b5c6d2; font-size: 8pt; font-weight: 700; letter-spacing: 1.2px; }
QLabel#contextChip { background: #263642; color: #d6e2ea; padding: 6px 10px; border-radius: 4px; }
QLabel#pageTitle { color: #e7eef3; font-size: 20pt; font-weight: 700; }

/* ── Buttons ─────────────────────────────────────────── */
QPushButton, QToolButton { padding: 7px 12px; background: #23323d; border: 1px solid #40525f; border-radius: 4px; color: #e1e9ef; }
QPushButton:hover, QToolButton:hover { background: #2d4352; border-color: #62798a; }
QPushButton:pressed { background: #365365; }
QPushButton:disabled { color: #4a6070; background: #1c2830; border-color: #344552; }
QPushButton#primary { background: #2d7dd2; color: #ffffff; border: none; padding: 8px 16px; border-radius: 4px; font-weight: 700; }
QPushButton#primary:hover { background: #3a8fe0; }
QPushButton#primary:pressed { background: #1e6ab5; }
QPushButton#primary:disabled { background: #1e4870; }
QPushButton#danger { background: #922f35; color: #ffffff; border: none; padding: 7px 12px; border-radius: 4px; }
QPushButton#danger:hover { background: #b03a42; }
QPushButton#success { background: #1d6e42; color: #ffffff; border: none; padding: 7px 12px; border-radius: 4px; }
QPushButton#success:hover { background: #258a54; }

/* ── Inputs ──────────────────────────────────────────── */
QLineEdit, QComboBox { background: #1a2731; border: 1px solid #465966; border-radius: 4px; padding: 6px 9px; color: #e1e9ef; }
QLineEdit:focus, QComboBox:focus { border-color: #2d7dd2; }
QComboBox::drop-down { border: none; width: 20px; }
QTextEdit, QPlainTextEdit { background: #1a2731; border: 1px solid #465966; border-radius: 4px; padding: 4px; color: #e1e9ef; }

/* ── Tables ──────────────────────────────────────────── */
QTableWidget { background: #17232c; alternate-background-color: #1c2a34; border: 1px solid #344651; gridline-color: #2c3c47; selection-background-color: #1e4976; selection-color: #ffffff; }
QTableWidget::item { padding: 5px 8px; }
QTableWidget::item:selected { background: #1e4976; color: #ffffff; }
QHeaderView::section { background: #23333e; color: #c7d4dd; padding: 7px 8px; border: none; border-bottom: 1px solid #40515d; border-right: 1px solid #344552; font-weight: 700; font-size: 9pt; }
QHeaderView::section:last { border-right: none; }

/* ── Cards / panels ──────────────────────────────────── */
QFrame#sectionCard { background: #192630; border: 1px solid #344651; border-radius: 5px; }
QFrame#metricCard { background: #192630; border: 1px solid #344651; border-radius: 5px; }
QLabel#sectionTitle { color: #d9e4eb; font-size: 11pt; font-weight: 700; }
QLabel#metricLabel { color: #9cafbb; font-size: 8pt; font-weight: 700; letter-spacing: 0.5px; }
QLabel#metricValue { color: #e5edf2; font-size: 16pt; font-weight: 700; }
QLabel#mutedText { color: #9bacb7; }
QLabel#findingTitle { color: #e5edf2; font-size: 11pt; font-weight: 700; }
QLabel#evidenceLabel { color: #9bacb7; font-size: 9pt; }

/* Status cards for dashboard */
QFrame#statusCard { background: #192630; border: 1px solid #344651; border-left: 3px solid #4a6272; border-radius: 4px; }
QFrame#statusCard[tone="verified"] { border-left-color: #2a7a52; }
QFrame#statusCard[tone="review"] { border-left-color: #c48b24; }
QFrame#statusCard[tone="critical"] { border-left-color: #922f35; }
QFrame#statusCard[tone="high"] { border-left-color: #922f35; }
QFrame#statusCard[tone="info"] { border-left-color: #2d7dd2; }
QFrame#statusCard[tone="unavailable"] { border-left-color: #4a5e6a; }

/* Scope panel */
QFrame#scopePanel { background: #1c2b38; border: 1px solid #344552; border-radius: 5px; }

/* Step cards for guided assessment */
QFrame#stepCard { background: #1c2830; border: 1px solid #344651; border-radius: 5px; }
QFrame#stepCard[state="active"] { background: #1a2e42; border-color: #2d7dd2; border-left: 3px solid #2d7dd2; }
QFrame#stepCard[state="done"] { background: #1b3028; border-color: #2a7a52; border-left: 3px solid #2a7a52; }
QFrame#stepCard[state="pending"] { background: #1c2830; border-color: #344651; }

/* ── Status badges ───────────────────────────────────── */
QLabel#statusBadge { padding: 4px 9px; border-radius: 4px; font-size: 8pt; font-weight: 700; }
QLabel#statusBadge[tone="verified"] { color: #a6dfbf; background: #203c30; border: 1px solid #3c6a52; }
QLabel#statusBadge[tone="info"] { color: #acd2ed; background: #203746; border: 1px solid #3c627a; }
QLabel#statusBadge[tone="review"] { color: #efd092; background: #46391f; border: 1px solid #80672f; }
QLabel#statusBadge[tone="critical"] { color: #efb0b0; background: #472727; border: 1px solid #824848; }
QLabel#statusBadge[tone="high"] { color: #efb0b0; background: #472727; border: 1px solid #824848; }
QLabel#statusBadge[tone="unavailable"] { color: #c0ccd4; background: #293740; border: 1px solid #4a5a65; }
QLabel#offlineStatus { color: #a6dfbf; background: #203c30; border: 1px solid #3c6a52; border-radius: 4px; padding: 5px 9px; font-weight: 700; font-size: 8pt; }

/* ── Progress bar ────────────────────────────────────── */
QProgressBar { border: 1px solid #465966; border-radius: 3px; background: #1c2a34; height: 8px; text-align: center; font-size: 8pt; color: #c8d4dd; }
QProgressBar::chunk { background: #2d7dd2; border-radius: 2px; }

/* ── Scrollbars ──────────────────────────────────────── */
QScrollBar:vertical { background: #111a22; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #344651; border-radius: 4px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #4a6272; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #111a22; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #344651; border-radius: 4px; min-width: 20px; }
QScrollBar::handle:horizontal:hover { background: #4a6272; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollArea { border: none; background: transparent; }

/* ── Splitter ────────────────────────────────────────── */
QSplitter::handle { background: #2a3a46; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }

/* ── GroupBox ────────────────────────────────────────── */
QGroupBox { border: 1px solid #344651; border-radius: 4px; margin-top: 8px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9cafbb; font-weight: 700; font-size: 9pt; }

/* ── TabWidget ───────────────────────────────────────── */
QTabWidget::pane { border: 1px solid #344651; background: #192630; border-radius: 0 4px 4px 4px; }
QTabBar::tab { background: #23333e; border: 1px solid #344651; border-bottom: none; padding: 6px 14px; border-radius: 4px 4px 0 0; color: #9cafbb; }
QTabBar::tab:selected { background: #192630; color: #e3ebf1; font-weight: 700; border-bottom: 1px solid #192630; }
QTabBar::tab:hover:!selected { background: #2a3d4d; }
