QWidget { background: #111a22; color: #e3ebf1; font-family: "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10pt; }
QMainWindow { background: #111a22; }
QFrame#sidebar { background: #0b131a; color: #e3ebf1; border: none; }
QFrame#sidebar QLabel { color: #e3ebf1; }
QLabel#brand { color: #ffffff; font-size: 15pt; font-weight: 700; padding: 4px 2px 10px 2px; }
QLabel#sidebarFooter { color: #9cadba; padding: 8px 2px; }
QFrame#appHeader { background: #19242e; border: none; border-bottom: 1px solid #344552; }
QLabel#pageContext { color: #b5c6d2; font-size: 9pt; font-weight: 700; letter-spacing: 1px; }
QLabel#contextChip { background: #263642; color: #d6e2ea; padding: 7px 10px; border-radius: 4px; }
QLabel#pageTitle { color: #e7eef3; font-size: 22pt; font-weight: 700; }
QTreeWidget#navigation { background: transparent; color: #c8d4dd; border: none; outline: none; }
QTreeWidget#navigation::item { padding: 9px 8px; border-radius: 4px; }
QTreeWidget#navigation::item:hover { background: #1d303e; }
QTreeWidget#navigation::item:selected { background: #315a78; color: #ffffff; font-weight: 700; }
QPushButton, QToolButton { padding: 8px 12px; background: #23323d; border: 1px solid #40525f; border-radius: 4px; color: #e1e9ef; }
QPushButton:hover, QToolButton:hover { background: #2d4352; border-color: #62798a; }
QPushButton:pressed { background: #365365; }
QLineEdit, QComboBox { background: #1a2731; border: 1px solid #465966; border-radius: 4px; padding: 7px 9px; color: #e1e9ef; }
QTableWidget { background: #17232c; alternate-background-color: #1c2a34; border: 1px solid #344651; gridline-color: #2c3c47; selection-background-color: #315a78; selection-color: #ffffff; }
QHeaderView::section { background: #23333e; color: #c7d4dd; padding: 7px; border: none; border-bottom: 1px solid #40515d; font-weight: 700; }
QFrame#sectionCard, QFrame#metricCard { background: #192630; border: 1px solid #344651; border-radius: 5px; }
QLabel#sectionTitle { color: #d9e4eb; font-size: 11pt; font-weight: 700; }
QLabel#metricLabel { color: #9cafbb; font-size: 8pt; font-weight: 700; }
QLabel#metricValue { color: #e5edf2; font-size: 17pt; font-weight: 700; }
QLabel#mutedText { color: #9bacb7; }
QLabel#statusBadge { padding: 5px 9px; border-radius: 4px; font-size: 8pt; font-weight: 700; }
QLabel#statusBadge[tone="verified"] { color: #a6dfbf; background: #203c30; border: 1px solid #3c6a52; }
QLabel#statusBadge[tone="info"] { color: #acd2ed; background: #203746; border: 1px solid #3c627a; }
QLabel#statusBadge[tone="review"] { color: #efd092; background: #46391f; border: 1px solid #80672f; }
QLabel#statusBadge[tone="critical"] { color: #efb0b0; background: #472727; border: 1px solid #824848; }
QLabel#statusBadge[tone="high"] { color: #efb0b0; background: #472727; border: 1px solid #824848; }
QLabel#statusBadge[tone="unavailable"] { color: #c0ccd4; background: #293740; border: 1px solid #4a5a65; }
QLabel#offlineStatus { color: #a6dfbf; background: #203c30; border: 1px solid #3c6a52; border-radius: 4px; padding: 6px; font-weight: 700; }
QScrollArea { border: none; background: transparent; }
