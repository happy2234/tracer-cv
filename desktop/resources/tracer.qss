QWidget { background: #f3f6f9; color: #17212b; font-family: "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10pt; }
QMainWindow { background: #f3f6f9; }
QFrame#sidebar { background: #162534; color: #eaf1f6; border: none; }
QFrame#sidebar QLabel { color: #eaf1f6; }
QLabel#brand { color: #ffffff; font-size: 15pt; font-weight: 700; padding: 4px 2px 10px 2px; }
QLabel#sidebarFooter { color: #a9bac9; padding: 8px 2px; }
QFrame#appHeader { background: #ffffff; border: none; border-bottom: 1px solid #d5dee7; }
QLabel#pageContext { color: #435568; font-size: 9pt; font-weight: 700; letter-spacing: 1px; }
QLabel#contextChip { background: #eef3f7; color: #32475a; padding: 7px 10px; border-radius: 4px; }
QLabel#pageTitle { color: #15283a; font-size: 22pt; font-weight: 700; }
QTreeWidget#navigation { background: transparent; color: #d8e2eb; border: none; outline: none; }
QTreeWidget#navigation::item { padding: 9px 8px; border-radius: 4px; }
QTreeWidget#navigation::item:hover { background: #263c50; }
QTreeWidget#navigation::item:selected { background: #315a78; color: #ffffff; font-weight: 700; }
QPushButton, QToolButton { padding: 8px 12px; background: #ffffff; border: 1px solid #cbd5df; border-radius: 4px; }
QPushButton:hover, QToolButton:hover { background: #e9f1f7; border-color: #9fb3c5; }
QPushButton:pressed { background: #d8e6f0; }
QLineEdit, QComboBox { background: #ffffff; border: 1px solid #cbd5df; border-radius: 4px; padding: 7px 9px; }
QTableWidget { background: #ffffff; alternate-background-color: #f5f8fa; border: 1px solid #d5dee7; gridline-color: #e5ebf0; selection-background-color: #dceaf4; selection-color: #17212b; }
QHeaderView::section { background: #edf2f6; color: #435568; padding: 7px; border: none; border-bottom: 1px solid #d5dee7; font-weight: 700; }
QFrame#sectionCard, QFrame#metricCard { background: #ffffff; border: 1px solid #d8e0e7; border-radius: 5px; }
QLabel#sectionTitle { color: #26394b; font-size: 11pt; font-weight: 700; }
QLabel#metricLabel { color: #617487; font-size: 8pt; font-weight: 700; }
QLabel#metricValue { color: #172c3e; font-size: 17pt; font-weight: 700; }
QLabel#mutedText { color: #647789; }
QLabel#statusBadge { padding: 5px 9px; border-radius: 4px; font-size: 8pt; font-weight: 700; }
QLabel#statusBadge[tone="verified"] { color: #175b3c; background: #e0f2e9; border: 1px solid #acd8bf; }
QLabel#statusBadge[tone="info"] { color: #245478; background: #e6f0f7; border: 1px solid #bfd4e3; }
QLabel#statusBadge[tone="review"] { color: #80520b; background: #fff2d8; border: 1px solid #ebd09a; }
QLabel#statusBadge[tone="critical"] { color: #8c2a2a; background: #fae5e5; border: 1px solid #e6b5b5; }
QLabel#statusBadge[tone="high"] { color: #8c2a2a; background: #fae5e5; border: 1px solid #e6b5b5; }
QLabel#statusBadge[tone="unavailable"] { color: #596875; background: #e8edf1; border: 1px solid #c8d1d8; }
QLabel#offlineStatus { color: #175b3c; background: #e0f2e9; border: 1px solid #acd8bf; border-radius: 4px; padding: 6px; font-weight: 700; }
QScrollArea { border: none; background: transparent; }
