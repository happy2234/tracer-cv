/* TRACER-CV Light Theme */
QWidget { background: #f3f6f9; color: #17212b; font-family: "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10pt; }
QMainWindow { background: #f3f6f9; }
QDialog { background: #f3f6f9; }

/* ── Sidebar ─────────────────────────────────────────── */
QFrame#sidebar { background: #162534; color: #eaf1f6; border: none; }
QFrame#sidebar QLabel { color: #eaf1f6; }
QLabel#brand { color: #ffffff; font-size: 13pt; font-weight: 700; padding: 4px 2px 10px 2px; }
QLabel#sidebarFooter { color: #7a95a8; font-size: 8pt; padding: 8px 2px; }
QLabel#groupHeader { color: #5e7f93; font-size: 7pt; font-weight: 700; letter-spacing: 1.5px; padding: 14px 4px 3px 4px; }

/* Navigation tree */
QTreeWidget#navigation { background: transparent; color: #d0dde6; border: none; outline: none; }
QTreeWidget#navigation::item { padding: 7px 8px; border-radius: 4px; min-height: 28px; }
QTreeWidget#navigation::item:hover { background: #223748; }
QTreeWidget#navigation::item:selected { background: #1e4976; color: #ffffff; font-weight: 700; }

/* ── App header ──────────────────────────────────────── */
QFrame#appHeader { background: #ffffff; border: none; border-bottom: 1px solid #d5dee7; }
QLabel#pageContext { color: #435568; font-size: 8pt; font-weight: 700; letter-spacing: 1.2px; }
QLabel#contextChip { background: #eef3f7; color: #32475a; padding: 6px 10px; border-radius: 4px; }
QLabel#pageTitle { color: #15283a; font-size: 20pt; font-weight: 700; }

/* ── Buttons ─────────────────────────────────────────── */
QPushButton, QToolButton { padding: 7px 12px; background: #ffffff; border: 1px solid #c8d3dc; border-radius: 4px; color: #17212b; }
QPushButton:hover, QToolButton:hover { background: #e9f1f7; border-color: #9fb3c5; }
QPushButton:pressed { background: #d8e6f0; }
QPushButton:disabled { color: #a0b0bc; background: #f0f3f6; border-color: #dde4ea; }
QPushButton#primary { background: #1a5fa8; color: #ffffff; border: none; padding: 8px 16px; border-radius: 4px; font-weight: 700; }
QPushButton#primary:hover { background: #1a73c4; }
QPushButton#primary:pressed { background: #154d8a; }
QPushButton#primary:disabled { background: #7ea8d0; }
QPushButton#danger { background: #c0392b; color: #ffffff; border: none; padding: 7px 12px; border-radius: 4px; }
QPushButton#danger:hover { background: #e74c3c; }
QPushButton#success { background: #1a7a4c; color: #ffffff; border: none; padding: 7px 12px; border-radius: 4px; }
QPushButton#success:hover { background: #229a5e; }

/* ── Inputs ──────────────────────────────────────────── */
QLineEdit, QComboBox { background: #ffffff; border: 1px solid #c8d3dc; border-radius: 4px; padding: 6px 9px; }
QLineEdit:focus, QComboBox:focus { border-color: #1a5fa8; }
QComboBox::drop-down { border: none; width: 20px; }
QTextEdit, QPlainTextEdit { background: #ffffff; border: 1px solid #c8d3dc; border-radius: 4px; padding: 4px; }

/* ── Tables ──────────────────────────────────────────── */
QTableWidget { background: #ffffff; alternate-background-color: #f5f8fa; border: 1px solid #d5dee7; gridline-color: #e5ebf0; selection-background-color: #d4e8f7; selection-color: #17212b; }
QTableWidget::item { padding: 5px 8px; }
QTableWidget::item:selected { background: #d4e8f7; color: #17212b; }
QHeaderView::section { background: #edf2f6; color: #435568; padding: 7px 8px; border: none; border-bottom: 1px solid #d5dee7; border-right: 1px solid #e5ebf0; font-weight: 700; font-size: 9pt; }
QHeaderView::section:last { border-right: none; }

/* ── Cards / panels ──────────────────────────────────── */
QFrame#sectionCard { background: #ffffff; border: 1px solid #d8e0e7; border-radius: 5px; }
QFrame#metricCard { background: #ffffff; border: 1px solid #d8e0e7; border-radius: 5px; }
QLabel#sectionTitle { color: #26394b; font-size: 11pt; font-weight: 700; }
QLabel#metricLabel { color: #617487; font-size: 8pt; font-weight: 700; letter-spacing: 0.5px; }
QLabel#metricValue { color: #172c3e; font-size: 16pt; font-weight: 700; }
QLabel#mutedText { color: #647789; }
QLabel#findingTitle { color: #172c3e; font-size: 11pt; font-weight: 700; }
QLabel#evidenceLabel { color: #647789; font-size: 9pt; }

/* Status cards for dashboard (colored left border) */
QFrame#statusCard { background: #ffffff; border: 1px solid #d8e0e7; border-left: 3px solid #9fb3c5; border-radius: 4px; }
QFrame#statusCard[tone="verified"] { border-left-color: #1a7a4c; }
QFrame#statusCard[tone="review"] { border-left-color: #c48b24; }
QFrame#statusCard[tone="critical"] { border-left-color: #c0392b; }
QFrame#statusCard[tone="high"] { border-left-color: #c0392b; }
QFrame#statusCard[tone="info"] { border-left-color: #1a5fa8; }
QFrame#statusCard[tone="unavailable"] { border-left-color: #95a5a6; }

/* Scope panel */
QFrame#scopePanel { background: #eef3f7; border: 1px solid #c8d5df; border-radius: 5px; }

/* Step cards for guided assessment */
QFrame#stepCard { background: #f5f8fb; border: 1px solid #d5dee7; border-radius: 5px; }
QFrame#stepCard[state="active"] { background: #eaf3fc; border-color: #1a5fa8; border-left: 3px solid #1a5fa8; }
QFrame#stepCard[state="done"] { background: #f0faf4; border-color: #acd8bf; border-left: 3px solid #1a7a4c; }
QFrame#stepCard[state="pending"] { background: #f5f8fb; border-color: #d5dee7; }

/* ── Status badges ───────────────────────────────────── */
QLabel#statusBadge { padding: 4px 9px; border-radius: 4px; font-size: 8pt; font-weight: 700; }
QLabel#statusBadge[tone="verified"] { color: #175b3c; background: #e0f2e9; border: 1px solid #acd8bf; }
QLabel#statusBadge[tone="info"] { color: #245478; background: #e6f0f7; border: 1px solid #bfd4e3; }
QLabel#statusBadge[tone="review"] { color: #80520b; background: #fff2d8; border: 1px solid #ebd09a; }
QLabel#statusBadge[tone="critical"] { color: #8c2a2a; background: #fae5e5; border: 1px solid #e6b5b5; }
QLabel#statusBadge[tone="high"] { color: #8c2a2a; background: #fae5e5; border: 1px solid #e6b5b5; }
QLabel#statusBadge[tone="unavailable"] { color: #596875; background: #e8edf1; border: 1px solid #c8d1d8; }
QLabel#offlineStatus { color: #175b3c; background: #e0f2e9; border: 1px solid #acd8bf; border-radius: 4px; padding: 5px 9px; font-weight: 700; font-size: 8pt; }

/* ── Progress bar ────────────────────────────────────── */
QProgressBar { border: 1px solid #c8d3dc; border-radius: 3px; background: #eef2f5; height: 8px; text-align: center; font-size: 8pt; }
QProgressBar::chunk { background: #1a5fa8; border-radius: 2px; }

/* ── Scrollbars ──────────────────────────────────────── */
QScrollBar:vertical { background: #f3f6f9; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #c0cdd6; border-radius: 4px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #9fb3c5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #f3f6f9; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #c0cdd6; border-radius: 4px; min-width: 20px; }
QScrollBar::handle:horizontal:hover { background: #9fb3c5; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollArea { border: none; background: transparent; }

/* ── Splitter ────────────────────────────────────────── */
QSplitter::handle { background: #e0e8ef; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }

/* ── GroupBox ────────────────────────────────────────── */
QGroupBox { border: 1px solid #d5dee7; border-radius: 4px; margin-top: 8px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #435568; font-weight: 700; font-size: 9pt; }

/* ── TabWidget ───────────────────────────────────────── */
QTabWidget::pane { border: 1px solid #d5dee7; background: #ffffff; border-radius: 0 4px 4px 4px; }
QTabBar::tab { background: #edf2f6; border: 1px solid #d5dee7; border-bottom: none; padding: 6px 14px; border-radius: 4px 4px 0 0; color: #435568; }
QTabBar::tab:selected { background: #ffffff; color: #172c3e; font-weight: 700; border-bottom: 1px solid #ffffff; }
QTabBar::tab:hover:!selected { background: #e4ecf3; }
